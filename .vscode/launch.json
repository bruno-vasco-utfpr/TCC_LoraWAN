{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceRoot}",
            "executable": "./build/helloblackpillSTM32F411CEUx.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "device": "STM32F411CE",
            "gdbPath": "/opt/gcc-arm-none-eabi/bin/arm-none-eabi-gdb",
            "openOCDPath": "/usr/bin/openocd",
            "openOCDLaunchCommands": [ "adapter speed 1000" ],
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "rtos": "FreeRTOS",
            "svdFile": "STM32F411.svd",
            "preLaunchTask": "build",
            
            // ESSAS LINHAS SÃO A CHAVE DO SUCESSO
            "gdbTarget": "localhost:3333",
            "showDevDebugOutput": "raw",
            "runToEntryPoint": "main"
        }
    ]
}   